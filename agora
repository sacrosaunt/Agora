#!/usr/bin/env python3
"""agora: a tiny shared discussion thread for several coding agents reading one codebase.

Participants: user, claude, codex, hydrogen (Antigravity). Messages live in thread.jsonl (source of truth) and are
rendered to thread.md. Everyone reads the code from the snapshot in ./code (git-tracked files of the source repo).

Config: agora.json next to this script (see agora.example.json), overridden by env AGORA_SRC and
AGORA_EXCLUDE (comma-separated):  {"src": "/path/to/repo", "exclude": ["data/", "runs/", ...]}
  src      the git repo to snapshot into ./code
  exclude  path prefixes left out of the snapshot (a trailing / means a directory); gitignored files are
           always left out
  project  markdown file with project notes appended to the protocol (default PROJECT.md here)
  agy      Antigravity CLI binary (default: agy on PATH)
  claude   Claude Code CLI binary (default: claude on PATH, else ~/.local/bin/claude)
  serve    agents the serve loop runs headlessly (default: all three; drop one whose seat a person runs)
  max_turns, max_tokens   session rotation limits (defaults 40 turns, 300000 context tokens)

Each headless agent keeps one persistent CLI session (codex thread / Antigravity conversation / Claude Code
session, all on the local logins, no API keys) and is resumed with only the messages it hasn't seen. A fresh
session (full protocol + thread) starts deterministically when there is none, after max_turns turns, past
max_tokens of context, when the protocol or project notes change, after a failed turn, or on `agora reset`.

  agora post -a NAME [-t to1,to2|all] [TEXT... | -f FILE | - (stdin)]
                                         as user in a terminal: posts, then opens the live chat (-q: don't)
  agora  (or: agora chat [-t to] [--last N])   join the live chat as user: shows the last N messages, follows
                                         the thread and posts what you type
  agora read [-a NAME] [--new] [--last N] [--json]   --new: only unseen messages for NAME, then mark them seen
  agora wait -a NAME [--timeout S]       block until a message for NAME arrives, print it, mark seen
  agora doing -a NAME [--id ID [--bg] [--done]] TEXT   show what NAME is doing in the chat (phase, or one of
                                         several concurrent actions); wait sets it, posting clears it
  agora idle -a NAME                     clear NAME's activity
  agora sync                             refresh ./code from the configured src (tracked + untracked-not-ignored files)
  agora claude | codex | hydrogen        run that agent once on the thread and post its reply
  agora serve [--budget N] [--only X]    loop: answer as the serve agents whenever a message is addressed to them
  agora reset [NAME|all]                 drop agent sessions: their next turn starts fresh
  agora status
  agora protocol                         print the protocol (PROTOCOL.md + the project notes) with real paths
  agora intro hydrogen                   print the starter prompt for a manually run hydrogen (HYDROGEN.md)
"""
import argparse, fcntl, json, os, re, shutil, subprocess, sys, tempfile, time

HOME = os.path.dirname(os.path.realpath(__file__))
VENV = os.path.join(HOME, ".venv")  # optional: python -m venv .venv && .venv/bin/pip install -r requirements.txt
if os.path.isfile(os.path.join(VENV, "bin", "python")) and os.path.realpath(sys.prefix) != os.path.realpath(VENV):
    os.execv(os.path.join(VENV, "bin", "python"), [os.path.join(VENV, "bin", "python"), os.path.realpath(__file__)] + sys.argv[1:])
THREAD, MD, STATE = (os.path.join(HOME, x) for x in ("thread.jsonl", "thread.md", "state"))
CODE, CONFIG = os.path.join(HOME, "code"), os.path.join(HOME, "agora.json")
NAMES = ("user", "claude", "codex", "hydrogen")
AGENTS = ("claude", "codex", "hydrogen")


def load_config():
    global CFG
    cfg = {}
    if os.path.exists(CONFIG):
        with open(CONFIG) as f:
            cfg = json.load(f)
    CFG = cfg
    src = os.environ.get("AGORA_SRC") or cfg.get("src")
    ex = os.environ.get("AGORA_EXCLUDE")
    ex = [x.strip() for x in ex.split(",")] if ex is not None else cfg.get("exclude", [])
    proj = os.path.join(HOME, os.path.expanduser(os.environ.get("AGORA_PROJECT") or cfg.get("project", "PROJECT.md")))
    agy = os.environ.get("AGORA_AGY") or cfg.get("agy") or shutil.which("agy") or "agy"
    return (os.path.expanduser(src) if src else None), tuple(x for x in ex if x), proj, os.path.expanduser(agy)


SRC, EXCLUDE, PROJECT, AGY = load_config()
CLAUDE = os.path.expanduser(os.environ.get("AGORA_CLAUDE") or CFG.get("claude") or shutil.which("claude")
                            or "~/.local/bin/claude")
MAX_TURNS, MAX_TOKENS = int(CFG.get("max_turns", 40)), int(CFG.get("max_tokens", 300_000))


def winpath(path):
    """Under WSL, (the Windows path of a Linux path, the command prefix to run this script from Windows)."""
    try:
        w = subprocess.run(["wslpath", "-w", path], capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return path, ""
    m = re.match(r"\\\\wsl(?:\.localhost|\$)\\([^\\]+)", w)
    return w, (f"wsl -d {m.group(1)} " if m else "")


def template(name, **kw):
    with open(os.path.join(HOME, name)) as f:
        s = f.read()
    for k, v in kw.items():
        s = s.replace("{" + k + "}", v)
    return s


def protocol():
    s = template("PROTOCOL.md", agora=os.path.realpath(__file__), code=CODE, thread=MD)
    if os.path.exists(PROJECT):
        with open(PROJECT) as f:
            s = s.rstrip() + "\n\n" + f.read()
    return s
BUDGET = 400  # max agent messages since the last user message before Codex stops auto-replying


def load():
    if not os.path.exists(THREAD):
        return []
    with open(THREAD) as f:
        return [json.loads(l) for l in f if l.strip()]


def render(msgs):
    out = ["# Agora thread\n", "Read-only codebase snapshot: `" + CODE + "`. Protocol: `agora protocol`.\n"]
    for m in msgs:
        out.append(f"\n---\n### #{m['id']} {m['from']} → {', '.join(m['to'])} · {m['ts']}\n\n{m['text'].rstrip()}\n")
    tmp = MD + ".tmp"
    with open(tmp, "w") as f:
        f.writelines(out)
    os.replace(tmp, MD)


def post(frm, to, text):
    frm = frm.lower()
    if frm not in NAMES:
        sys.exit(f"unknown author {frm!r}; use one of {NAMES}")
    to = [t.strip().lower() for t in (to or "all").split(",") if t.strip()]
    bad = [t for t in to if t not in NAMES + ("all",)]
    if bad:
        sys.exit(f"unknown recipient(s) {bad}")
    text = text.strip()
    if not text:
        sys.exit("empty message")
    with open(THREAD, "a+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.seek(0)
        n = sum(1 for l in f if l.strip())
        m = {"id": n + 1, "from": frm, "to": to, "ts": time.strftime("%Y-%m-%d %H:%M:%S"), "text": text}
        f.write(json.dumps(m, ensure_ascii=False) + "\n")
        f.flush()
        fcntl.flock(f, fcntl.LOCK_UN)
    render(load())
    if frm == "user" and to == ["all"] and "@" not in text:
        take_turns(m["id"])
    if frm != "user":
        busy(frm, False)
        if frm in AGENTS and to and all(t in AGENTS and t != frm for t in to):
            sleep_set(frm, True, why="auto", until_from=to)   # asked another agent: wait for its answer
    return m


SLEEP = os.path.join(STATE, "sleep")  # <name>.json while an agent sleeps: it skips messages to "all" until pinged


def pinged(m, name):
    """Addressed to name by name (-t name), or mentioning @name anywhere in the text."""
    return m["from"] != name and (name in m["to"] or re.search(r"(?<![\w@])@" + name + r"\b", m["text"], re.I))


def asleep(name):
    """The sleep record {since, until, why} of a sleeping agent, else None (expired sleeps end by themselves)."""
    p = os.path.join(SLEEP, name + ".json")
    try:
        z = json.load(open(p))
    except (OSError, ValueError):
        return None
    if z.get("until") and time.time() > z["until"]:
        try:
            os.unlink(p)
        except OSError:
            pass
        return None
    return z


def sleep_set(name, on=True, secs=None, why="", until_from=()):
    os.makedirs(SLEEP, exist_ok=True)
    p = os.path.join(SLEEP, name + ".json")
    if not on:
        try:
            os.unlink(p)
        except OSError:
            pass
        return
    with open(p, "w") as f:
        json.dump({"since": time.time(), "until": time.time() + secs if secs else None, "why": why,
                   "from": [x for x in until_from if x != name], "after": len(load())}, f)


def take_turns(mid):
    """A question to all gets one lead answer (agents rotate); the others wait for it, then add only what's new."""
    os.makedirs(STATE, exist_ok=True)
    p = os.path.join(STATE, "lead")
    try:
        i = int(open(p).read())
    except (OSError, ValueError):
        i = -1
    lead = AGENTS[(i + 1) % len(AGENTS)]
    with open(p, "w") as f:
        f.write(str(AGENTS.index(lead)))
    for n in AGENTS:
        if n != lead and not (asleep(n) or {}).get("why") == "user":
            sleep_set(n, True, 900, why="turn", until_from=[lead])   # wakes on the lead's answer, a ping, or after 15 min


def for_me(m, name):
    """Pings always count. A sleeper waiting for someone (WAIT: codex) wakes on that one's next message,
    whoever it is addressed to; otherwise sleepers skip messages to all."""
    if pinged(m, name):
        return True
    z = asleep(name)
    if z and z.get("from") and m["from"] in z["from"] and m["id"] > z.get("after", 0):
        return True
    if z and m["from"] == "user" and "all" in m["to"] and z.get("why") not in ("user", "turn") \
            and m["id"] > z.get("after", 0):
        return True   # the user speaking to everyone wakes agents that went to sleep on their own
    return m["from"] != name and "all" in m["to"] and not z


def seen(name, val=None):
    os.makedirs(STATE, exist_ok=True)
    p = os.path.join(STATE, name + ".seen")
    if val is not None:
        with open(p, "w") as f:
            f.write(str(val))
        return val
    try:
        return int(open(p).read())
    except (OSError, ValueError):
        return 0


def fmt(m):
    return f"### #{m['id']} {m['from']} → {', '.join(m['to'])} · {m['ts']}\n\n{m['text'].rstrip()}\n"


def sync():
    """Refresh ./code from SRC (serialized: concurrent one-shot runs would race on the directory swap)."""
    if not SRC or not os.path.isdir(SRC):
        sys.exit(f"agora: no source repo configured (got {SRC!r}); set \"src\" in {CONFIG} or AGORA_SRC")
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, "sync.lock"), "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        return _sync()


def _sync():
    files = subprocess.run(["git", "-C", SRC, "ls-files", "-z", "-co", "--exclude-standard"],
                           capture_output=True, check=True).stdout.decode().split("\0")
    files = [f for f in files if f and not f.startswith(EXCLUDE) and os.path.isfile(os.path.join(SRC, f))]
    dig = __import__("hashlib").sha1()
    for f in files:
        st = os.stat(os.path.join(SRC, f))
        dig.update(f"{f}\0{st.st_size}\0{st.st_mtime_ns}\n".encode())
    new = os.path.join(HOME, "code.new")
    shutil.rmtree(new, ignore_errors=True)
    for f in files:
        d = os.path.join(new, f)
        os.makedirs(os.path.dirname(d), exist_ok=True)
        shutil.copy2(os.path.join(SRC, f), d)
    head = subprocess.run(["git", "-C", SRC, "log", "-1", "--format=%h %s"], capture_output=True, text=True).stdout
    with open(os.path.join(new, "SNAPSHOT.txt"), "w") as fh:
        fh.write(f"Snapshot of {SRC} at {time.strftime('%Y-%m-%d %H:%M:%S')}, HEAD {head}"
                 f"{len(files)} files; excluded: {', '.join(EXCLUDE) or 'nothing'} plus gitignored files.\n")
    old = os.path.join(HOME, "code.old")
    shutil.rmtree(old, ignore_errors=True)
    if os.path.exists(CODE):
        os.rename(CODE, old)
    os.rename(new, CODE)
    shutil.rmtree(old, ignore_errors=True)
    with open(os.path.join(STATE, "snapshot.json"), "w") as fh:  # content digest: sessions note real changes only
        json.dump({"digest": dig.hexdigest()[:12], "head": head.strip()}, fh)
    return len(files)


AUTO = tuple(CFG.get("serve") or AGENTS)  # agents the serve loop runs headlessly
SESS = os.path.join(STATE, "sessions")  # <name>.json: the agent's persistent CLI session


def session(name, val=None, drop=False):
    """Read (default), write (val) or drop an agent's session record."""
    f = os.path.join(SESS, name + ".json")
    if drop:
        if os.path.exists(f):
            os.unlink(f)
        return None
    if val is not None:
        os.makedirs(SESS, exist_ok=True)
        with open(f + ".tmp", "w") as g:
            json.dump(val, g)
        os.replace(f + ".tmp", f)
        return val
    try:
        return json.load(open(f))
    except (OSError, ValueError):
        return None


def stale(name, s, phash):
    """Why session s must be replaced by a fresh one (None: resume it)."""
    if not s or not s.get("id"):
        return "no session"
    if s.get("turns", 0) >= MAX_TURNS:
        return f"{s['turns']} turns"
    if s.get("tokens", 0) >= MAX_TOKENS:
        return f"{s['tokens']} tokens"
    if s.get("proto") != phash:
        return "protocol changed"
    return None


def codex_event(name, e, res):
    if e.get("type") == "thread.started":
        res["sid"] = e.get("thread_id")
    elif e.get("type") == "turn.completed":
        res["tokens"] = (e.get("usage") or {}).get("input_tokens", 0)
    it = e.get("item") or {}
    typ, key = it.get("type"), it.get("id")
    if e.get("type") == "item.started":
        if typ == "command_execution":
            act(name, key, describe_cmd(it.get("command", "")))
        elif typ == "web_search":
            act(name, key, "searching the web")
        elif typ == "mcp_tool_call":
            act(name, key, "calling " + str(it.get("tool", "a tool")))
        elif typ == "reasoning":
            busy(name, True, "thinking")
    elif e.get("type") == "item.completed":
        act(name, key)
        if typ == "agent_message":
            busy(name, True, "writing")
        elif typ in ("command_execution", "web_search", "mcp_tool_call"):
            busy(name, True, "thinking")


def agy_event(name, e, res):
    if e.get("conversation_id"):
        res["sid"] = e["conversation_id"]
    if e.get("event") == "result":
        r = e.get("result") or {}
        res["text"], res["sid"] = r.get("response", ""), r.get("conversation_id") or res.get("sid")
        res["tokens"] = (r.get("usage") or {}).get("input_tokens", 0)
        return
    su = e.get("step_update") or {}
    key, st = su.get("step_index"), su.get("state")
    if su.get("step_type") == "tool":
        if st == "ACTIVE":
            info = su.get("tool_info") or {}
            pr = info.get("parameters") or {}
            bg = bool(pr.get("WaitMsBeforeAsync")) or bool(pr.get("Background") or pr.get("RunInBackground"))
            act(name, key, describe_tool(su.get("tool_name", "tool"), pr), bg=bg)
        else:
            act(name, key)
            busy(name, True, "thinking")
    elif su.get("step_type") == "agent_response" and st == "ACTIVE":
        busy(name, True, "writing")


def stream(name, cmd, stdin_text, cwd, env, log, timeout, on_event):
    """Run an agent CLI that prints JSONL events, feeding each to on_event (activity tracking); returns the process."""
    import threading
    p = subprocess.Popen(cmd, cwd=cwd, env=env, text=True, stdin=subprocess.PIPE if stdin_text else subprocess.DEVNULL,
                         stdout=subprocess.PIPE, stderr=log)
    if stdin_text:
        p.stdin.write(stdin_text)
        p.stdin.close()
    killer = threading.Timer(timeout, p.kill)
    killer.start()
    try:
        for line in p.stdout:
            try:
                e = json.loads(line)
            except ValueError:
                log.write(line)
                continue
            try:
                on_event(name, e)
            except Exception as ex:  # activity display must never break a turn
                log.write(f"[activity] {ex!r}\n")
        p.wait()
    finally:
        killer.cancel()
    return p


def rules(name):
    return ("Output ONLY your message text "
            "(no preamble). Optionally make the first line `TO: name1,name2` (default: the author of the "
            "latest message). If you have nothing worth adding, output only `SLEEP`: nothing is posted and you "
            "stop answering messages to all until someone pings you (`@" + name + "` or addresses you by name). "
            "A first line `SLEEP` before a message posts it and then sleeps. To hold off until a specific "
            "participant has replied (e.g. you asked codex to check something), use a first line `WAIT: codex` "
            "(with or without a message after it): you skip everything until codex posts, then get a turn. "
            "Sleeping is automatic too: after a message addressed only to other agents you wait for their answer; "
            "a ping or the user writing to all wakes you. Questions to all are answered by one agent first; if "
            "another agent has already answered what you were asked, reply only with a correction or something "
            "new, otherwise output only `SLEEP`.\n\n"
            "LENGTH (rule 3, strictly): answer in 1-5 short lines, under ~600 characters. A one-line question "
            "gets a short answer. Go longer only if the user explicitly asked for an audit, report or design, "
            "and then still lead with a one-line summary. Cut background, recaps and anything already said in "
            "the thread.\n")


def snapshot_head():
    """(content digest, HEAD line) of the current code snapshot."""
    try:
        d = json.load(open(os.path.join(STATE, "snapshot.json")))
        return d["digest"], d["head"]
    except (OSError, ValueError, KeyError):
        return "", ""


def agent_cmd(name, sid, work, out):
    """The CLI command for one turn of name: fresh when sid is None, else resuming session sid.
    Returns (cmd, prompt_on_stdin)."""
    if name == "codex":  # codex exec resume has no -C: the cwd (work) is the workspace either way
        base = ["codex", "exec"] + (["resume"] if sid else []) + ["--json", "--skip-git-repo-check"]
        return base + ([] if sid else ["-C", work]) + [
            "-c", "model_reasoning_effort=" + os.environ.get("AGORA_CODEX_EFFORT", "medium"),
            "-o", out] + ([sid] if sid else []) + ["-"], True
    if name == "hydrogen":  # Antigravity print mode: workspace = code snapshot + work dir; approvals auto-denied
        return [AGY, "--model", os.environ.get("AGORA_HYDROGEN_MODEL", "gemini-4-hydrogen-high"),
                "--add-dir", CODE, "--output-format", "stream-json"] + (["--conversation", sid] if sid else []), False
    # claude: Claude Code print mode on the local login, read-only tools; no user settings/hooks, MCP servers or
    # skills (they cost ~150k context tokens per turn); prompt on stdin
    cmd = [CLAUDE, "-p", "--output-format", "stream-json", "--verbose", "--setting-sources", "project,local",
           "--strict-mcp-config", "--disable-slash-commands", "--add-dir", CODE, "--tools", "Read", "Grep", "Glob"]
    for flag, env in (("--model", "AGORA_CLAUDE_MODEL"), ("--effort", "AGORA_CLAUDE_EFFORT")):
        if os.environ.get(env) or CFG.get(env[6:].lower()):
            cmd += [flag, os.environ.get(env) or CFG[env[6:].lower()]]
    return cmd + (["--resume", sid] if sid else []), True


def agent_env(name):
    """Local CLI logins only: drop API keys (they would switch the CLIs to API billing) and, for claude, the
    variables that tie a nested Claude Code to the session that started agora."""
    drop = {"OPENAI_API_KEY", "CODEX_API_KEY", "ANTHROPIC_API_KEY"}
    env = {k: v for k, v in os.environ.items()
           if k not in drop and not (name == "claude" and (k.startswith("CLAUDE_CODE_") or k in ("CLAUDECODE", "CLAUDE_PID", "CLAUDE_EFFORT")))}
    if name == "codex":
        env["CODEX_HOME"] = os.path.join(HOME, ".codex-home")
    return env


def run_agent(name, timeout=1800, do_sync=True):
    """Run one headless turn of an agent on the thread and post its reply. Resumes the agent's persistent
    session with just the unseen messages, or starts a fresh one (see stale())."""
    if do_sync:
        sync()
    msgs = load()
    thread = "".join(fmt(m) for m in msgs)
    if len(thread) > 200_000:
        thread = "[earlier messages truncated; full thread in " + MD + "]\n\n" + thread[-200_000:]
    new = [m["id"] for m in msgs if for_me(m, name) and m["id"] > seen(name)]
    work = os.path.join(HOME, "work", name)
    os.makedirs(work, exist_ok=True)
    with open(os.path.join(work, "THREAD.md"), "w") as f:
        f.write("# Thread so far\n\n" + thread)
    proto = protocol()
    phash = __import__("hashlib").sha1((proto + rules(name)).encode()).hexdigest()[:12]
    head, head_line = snapshot_head()
    fresh_prompt = (proto + f"\n\n# You are: {name}\n\nThe codebase is at {CODE} (read-only). The full thread is in "
                    f"{work}/THREAD.md: read it first. Reply to the new message(s) addressed to you: {new}. "
                    "Only read files under the codebase and that thread file. " + rules(name))
    log = open(os.path.join(STATE, name + ".log"), "a")
    s = session(name)
    why = stale(name, s, phash)
    out = os.path.join(STATE, name + "_last.md")
    for attempt in (0, 1):
        if why:
            s, prompt = None, fresh_prompt
        else:
            unseen = [m for m in msgs if m["id"] > s.get("upto", 0) and m["from"] != name]
            prompt = ("# New in the thread since your last turn\n\n" + ("".join(fmt(m) for m in unseen) or "(nothing)\n")
                      + (f"\nThe code snapshot at {CODE} changed since your last turn (HEAD {head_line}); re-read files you rely on.\n"
                         if head != s.get("head") else "")
                      + f"\nReply to the message(s) addressed to you: {new}. Same rules as before: " + rules(name))
        log.write(f"\n=== {time.ctime()} replying to {new}: " + (f"fresh session ({why})" if why else
                  f"resuming {s['id']} (turn {s.get('turns', 0) + 1})") + "\n")
        log.flush()
        if os.path.exists(out):
            os.unlink(out)
        res = {}
        cmd, on_stdin = agent_cmd(name, s and s["id"], work, out)
        if not on_stdin:
            cmd.append("-p=" + prompt)
        handler = {"codex": codex_event, "hydrogen": agy_event, "claude": claude_event}[name]
        r = stream(name, cmd, prompt if on_stdin else None, work, agent_env(name), log, timeout,
                   lambda n, e: handler(n, e, res))
        text = (open(out).read() if name == "codex" and os.path.exists(out) else res.get("text") or "").strip()
        if name != "codex":
            log.write(text + "\n")
        if r.returncode == 0 and text and res.get("sid"):
            session(name, {"id": res["sid"], "turns": (s or {}).get("turns", 0) + 1, "tokens": res.get("tokens", 0),
                           "upto": msgs[-1]["id"] if msgs else 0, "proto": phash, "head": head,
                           "started": (s or {}).get("started") or time.strftime("%Y-%m-%d %H:%M:%S")})
            break
        session(name, drop=True)  # never resume a session whose last turn failed
        if why or r.returncode < 0:  # a fresh run failed, or the turn was killed (timeout): don't retry
            break
        why = f"resume failed (rc {r.returncode})"
        log.write(why + "; retrying fresh\n")
    if msgs:
        seen(name, msgs[-1]["id"])
    if r.returncode or not text:
        print(f"{name} failed (rc {r.returncode}); see {STATE}/{name}.log", file=sys.stderr)
        return None
    to, zz, wf = msgs[-1]["from"] if msgs else "all", False, []
    for _ in range(3):  # directive lines: TO: ..., SLEEP, WAIT: name, in any order
        first, _, rest = text.strip().partition("\n")
        d = first.strip().strip("`*")
        if d.upper().startswith("TO:"):
            to, text = d[3:].strip(), rest
        elif d.rstrip(".").upper() == "SLEEP":
            zz, text = True, rest
        elif d.upper().startswith("WAIT:"):
            wf = [x.strip().lower() for x in d[5:].split(",") if x.strip().lower() in NAMES and x.strip().lower() != name]
            zz, text = True, rest
    sleep_set(name, False)
    m = post(name, to, text) if text.strip() else None
    if zz:
        sleep_set(name, True, why="waiting for " + ",".join(wf) if wf else "nothing to add", until_from=wf)
        # no deadlock: whoever waits on name gets the turn if name waits on them (e.g. name was the lead) or if
        # name went quiet without posting (their wait would otherwise only end on the timeout)
        for x in AGENTS:
            if x != name and name in ((asleep(x) or {}).get("from") or []) and (x in wf or not m):
                sleep_set(x, False)
                print(f"{x} was waiting for {name}; woken", file=sys.stderr)
        print(f"{name} " + (f"waits for {','.join(wf)}" if wf else "sleeps until pinged"), file=sys.stderr)
    return m or ("slept" if zz else None)


def agent_streak(msgs):
    n = 0
    for m in reversed(msgs):
        if m["from"] == "user":
            break
        n += 1
    return n


COLORS = {"user": "1;37", "claude": "38;5;209", "codex": "38;5;114", "hydrogen": "38;5;75"}
ACT = os.path.join(STATE, "activity")  # <name>.json per agent working on a reply: phase + running actions


def _act_rw(name, fn, existing=False):
    os.makedirs(ACT, exist_ok=True)
    p = os.path.join(ACT, name + ".json")
    with open(p + ".lock", "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        if existing and not os.path.exists(p):
            return
        try:
            a = json.load(open(p))
        except (OSError, ValueError):
            a = {"phase": "thinking", "items": {}}
        a = fn(a)
        if a is None:
            if os.path.exists(p):
                os.unlink(p)
        else:
            a["t"] = time.time()
            with open(p + ".tmp", "w") as f:
                json.dump(a, f)
            os.replace(p + ".tmp", p)


def busy(name, on=True, phase="thinking"):
    """Mark an agent as working (phase text) or done (removes everything it was doing)."""
    _act_rw(name, (lambda a: {**a, "phase": phase}) if on else (lambda a: None))


def act(name, key, what=None, bg=False, existing=False):
    """Start (what given) or finish (what None) one concurrent action of an agent, e.g. a command."""
    def f(a):
        now = time.time()
        a["items"] = {k: v for k, v in a["items"].items() if v.get("until", now + 1) > now}
        if what is None:
            it = a["items"].get(str(key))
            if it and now - it["since"] < 1.5:  # keep quick actions on screen long enough to read
                it["until"] = it["since"] + 1.5
            else:
                a["items"].pop(str(key), None)
        else:
            a["items"][str(key)] = {"what": what, "bg": bg, "since": time.time()}
        return a
    _act_rw(name, f, existing)


def claude_hook(phase):
    """Claude Code Pre/PostToolUse hook: show claude's tool calls while it is working on a reply.
    No-op unless the hook's session is the one in state/claude.session and claude is already busy."""
    try:
        d = json.load(sys.stdin)
        want = open(os.path.join(STATE, "claude.session")).read().strip()
    except (OSError, ValueError):
        return
    if not want or d.get("session_id") != want:
        return
    tool, inp = d.get("tool_name", ""), d.get("tool_input") or {}
    key = d.get("tool_use_id") or tool
    if phase == "post":
        return act("claude", key, None, existing=True)
    what = claude_tool_text(tool, inp)
    if what:
        act("claude", key, what, bg=bool(inp.get("run_in_background")), existing=True)


def claude_tool_text(tool, inp):
    """Claude Code tool call -> short activity text (None: don't show)."""
    if tool == "Bash":
        cmd = inp.get("command", "")
        return None if "/agora " in cmd or cmd.startswith("agora ") else describe_cmd(cmd)
    if tool in ("Read", "Edit", "Write"):
        f = (inp.get("file_path") or "").replace(CODE + "/", "")
        return ("reading " if tool == "Read" else "editing ") + os.path.basename(f) if "/agora/" not in f else "reading " + f
    if tool in ("Grep", "Glob"):
        return f"searching `{(inp.get('pattern') or '')[:30]}`"
    if tool.startswith("Web") or "exa" in tool:
        return "searching the web"
    if tool == "Agent":
        return "running a subagent"
    return None


def claude_event(name, e, res):
    """Headless Claude Code (stream-json) event: activity, session id, reply text, context size."""
    t = e.get("type")
    if e.get("session_id"):
        res["sid"] = e["session_id"]
    if t == "assistant":
        msg = e.get("message") or {}
        u = msg.get("usage") or {}
        if u:  # context of the latest model call
            res["tokens"] = sum(u.get(k) or 0 for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
        for c in msg.get("content") or []:
            if c.get("type") == "tool_use":
                act(name, c.get("id"), claude_tool_text(c.get("name", ""), c.get("input") or {}) or c.get("name", "tool"))
            elif c.get("type") in ("thinking", "redacted_thinking"):
                busy(name, True, "thinking")
            elif c.get("type") == "text":
                busy(name, True, "writing")
    elif t == "user":
        for c in (e.get("message") or {}).get("content") or []:
            if isinstance(c, dict) and c.get("type") == "tool_result":
                act(name, c.get("tool_use_id"))
                busy(name, True, "thinking")
    elif t == "result":
        res["text"] = "" if e.get("is_error") else (e.get("result") or "")


def busy_now():
    """{name: activity} for agents working on a reply (stale after ~30 min without any update)."""
    out = {}
    try:
        for fn in os.listdir(ACT):
            if fn.endswith(".json"):
                try:
                    a = json.load(open(os.path.join(ACT, fn)))
                except (OSError, ValueError):
                    continue
                if time.time() - a.get("t", 0) < 1900:
                    out[fn[:-5]] = a
    except OSError:
        pass
    return dict(sorted(out.items()))


def describe_cmd(cmd):
    """Turn a shell command into 'reading x' / 'searching y' / 'running `z`'."""
    import re, shlex
    m = re.match(r"^(?:/bin/)?(?:ba)?sh -l?c (.*)$", cmd.strip(), re.S)
    if m:
        try:
            cmd = shlex.split(m.group(1))[0]
        except ValueError:
            cmd = m.group(1).strip("'\"")
    cmd = cmd.replace(CODE + "/", "").replace(CODE, "code").strip()
    if "\n" in cmd:   # multi-line (heredoc / script): first line only, so the status line never wraps
        cmd = cmd.split("\n", 1)[0].rstrip() + " …"
    try:
        w = shlex.split(cmd)
    except ValueError:
        w = cmd.split()
    if not w:
        return "running a command"
    files = [x for x in w[1:] if not x.startswith("-") and ("/" in x or "." in x) and " " not in x]
    if w[0] in ("cat", "sed", "head", "tail", "nl", "less", "bat") and "|" not in cmd and files:
        return "reading " + ", ".join(files[-2:])
    if w[0] in ("rg", "grep", "ag", "git") and "|" not in cmd:
        pat = next((x for x in w[1:] if not x.startswith("-")), "")
        return f"searching `{pat[:30]}`" if pat else "searching"
    if w[0] in ("ls", "find", "tree", "fd"):
        return "listing " + (files[0] if files else "files")
    return f"running `{cmd[:50]}{'…' if len(cmd) > 50 else ''}`"


def describe_tool(tool, params):
    """Antigravity tool step -> short activity text."""
    params = params or {}
    if "CommandLine" in params:
        return describe_cmd(params["CommandLine"])
    path = next((v for k, v in params.items() if isinstance(v, str) and ("Path" in k or "File" in k or k.lower() == "path")), None)
    if path:
        path = path.replace(CODE + "/", "")
        if "view" in tool or "read" in tool:
            return "reading " + path
        if "list" in tool or "dir" in tool:
            return "listing " + path
    q = next((v for k, v in params.items() if isinstance(v, str) and ("Query" in k or "Pattern" in k)), None)
    if q:
        return f"searching `{q[:30]}`"
    return tool.replace("_", " ")


def sleep_summary(zz):
    """One line naming every sleeping agent and what wakes it."""
    if not zz:
        return "everyone awake"
    parts = []
    for n in sorted(zz):
        wf = (asleep(n) or {}).get("from")
        parts.append(n + (f" (waiting for {', '.join(wf)})" if wf else ""))
    return "💤 asleep: " + ", ".join(parts) + " — @name pings one awake"


def act_text(a):
    """One agent's activity as plain text."""
    now = time.time()
    items = sorted((x for x in a.get("items", {}).values() if x.get("until", now + 1) > now), key=lambda x: x["since"])
    if not items:
        return a.get("phase", "thinking")
    fg = [x for x in items if not x["bg"]]
    bg = [x for x in items if x["bg"]]
    parts = []
    if fg:
        parts.append(fg[0]["what"] + (f" +{len(fg) - 1} more" if len(fg) > 1 else ""))
    if bg:
        parts.append(f"{len(bg)} in background" if fg or len(bg) > 1 else bg[0]["what"] + " (background)")
    return " ".join(", ".join(parts).split())   # one line, whatever the tool text held


def chat(to="all", after=None):
    """Live view: prints every new message as it lands and reads your replies from the prompt."""
    import readline, threading  # noqa: F401  (readline gives line editing + history to input())
    tty = sys.stdout.isatty()
    col = (lambda c, t: f"\033[{c}m{t}\033[0m") if tty else (lambda c, t: t)
    state = {"to": to, "last": after if after is not None else (load()[-1]["id"] if load() else 0),
             "busy": {}, "stop": False, "mine": set(), "shown": False, "frame": 0, "reading": False}
    lock = threading.Lock()

    def prompt():
        return col("2", f"[to {state['to']}] ") + "> "

    SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def zz_text():
        zz = state.get("zz") or {}
        return ("💤 " + ", ".join(n + (f" (waits for {', '.join(w)})" if w else "") for n, w in sorted(zz.items()))
                if zz else "")

    def has_line():
        return tty and bool(state["busy"] or state.get("zz"))

    def typing_line():
        """The status line above the prompt: who is working on what, then who is asleep."""
        width = shutil.get_terminal_size().columns - 1
        if not state["busy"]:
            z = zz_text()
            return col("2", z if len(z) <= width else z[:width - 1] + "…")
        out, used = col("2", SPIN[state["frame"] % len(SPIN)]), 1
        for n, a in state["busy"].items():
            what = act_text(a)
            room = width - used - len(n) - 5
            if room < 8:
                out += col("2", " …")
                break
            what = what if len(what) <= room else what[:room - 1] + "…"
            out += (col("2", " ·") if used > 1 else "") + " " + col(COLORS.get(n, "0"), n) + " " + col("2", what)
            used += len(n) + len(what) + 4
        z = zz_text()
        if z and width - used > 12:
            z = "  " + z
            out += col("2", z if len(z) <= width - used else z[:width - used - 1] + "…")
        return out

    def emit(text):
        """Print above the prompt, keeping the typing line (if any) directly above what you are typing."""
        with lock:
            buf = readline.get_line_buffer()
            out = "\r\033[K" + ("\033[1A\r\033[K" if state["shown"] else "") + text + "\n"
            state["shown"] = has_line()
            if state["shown"]:
                out += typing_line() + "\n"
            sys.stdout.write(out + (prompt() + buf if state["reading"] else ""))  # else input() draws it
            sys.stdout.flush()

    def animate():
        while not state["stop"]:
            time.sleep(0.12)
            if not tty:
                continue
            with lock:
                state["frame"] += 1
                line = typing_line() if has_line() else None
                if line is not None and state["shown"]:  # redraw the line above the prompt in place
                    if line == state.get("drawn"):
                        continue
                    sys.stdout.write("\0337\033[1A\r\033[K" + line + "\0338")
                elif line is not None:
                    sys.stdout.write("\r\033[K" + typing_line() + "\n" + (prompt() + readline.get_line_buffer() if state["reading"] else ""))
                    state["shown"] = True
                elif state["shown"]:
                    sys.stdout.write("\r\033[K\033[1A\r\033[K" + (prompt() + readline.get_line_buffer() if state["reading"] else ""))
                    state["shown"] = False
                else:
                    continue
                state["drawn"] = line
                sys.stdout.flush()

    def pings(out):  # @name mentions in bold, in that participant's colour
        if not tty:
            return out
        def hl(g):
            c = COLORS.get(g.group(1).lower(), "37").removeprefix("1;")
            return f"\033[1;{c}m{g.group(0)}\033[22;39m"
        return re.sub(r"(?<![\w@])@(" + "|".join(NAMES + ("all",)) + r")\b", hl, out, flags=re.I)

    def show(m):
        head = col(COLORS.get(m["from"], "0"), f"── #{m['id']} {m['from']}") + col("2", f" → {', '.join(m['to'])} · {m['ts'][11:]}")
        emit(head + "\n" + pings(md(m["text"])))

    def md(text):
        if not tty:
            return text.rstrip() + "\n"
        try:
            import io
            from rich.console import Console
            from rich.markdown import Markdown
            buf = io.StringIO()
            Console(file=buf, force_terminal=True, width=min(shutil.get_terminal_size().columns, 110)).print(
                Markdown(text, code_theme="ansi_dark", hyperlinks=False))
            return buf.getvalue().rstrip() + "\n"
        except Exception:
            return text.rstrip() + "\n"

    def follow():
        while not state["stop"]:
            for m in load():
                if m["id"] > state["last"]:
                    state["last"] = m["id"]
                    if m["id"] not in state["mine"]:  # your own lines are already on screen
                        show(m)
            state["busy"] = busy_now()
            zz = {n: tuple((asleep(n) or {}).get("from") or ()) for n in AGENTS if asleep(n)}  # who sleeps, and on whom
            if zz != state.setdefault("zz", zz):
                if not tty:   # in a terminal the status line above the prompt shows this in place
                    woke = sorted(set(state["zz"]) - set(zz))
                    emit((f"{', '.join(woke)} awake; " if woke else "") + sleep_summary(set(zz)))
                state["zz"] = zz
            if not tty and list(state["busy"]) != state.get("said"):
                state["said"] = list(state["busy"])
                if state["busy"]:
                    emit("… " + "; ".join(f"{n} {act_text(a)}" for n, a in state["busy"].items()))
            time.sleep(0.5)

    print(col("2", "Live chat. Type a message and press Enter to post it. @name,name at the start addresses it "
                   "(sticky); @name inside a message pings a sleeping agent; /to NAME sets recipients; /sleep NAME [30m] [until NAME], "
                   "/wake NAME; /all shows the whole thread; /status; /quit or Ctrl-D leaves."))
    if not tty and any(asleep(n) for n in AGENTS):
        print(sleep_summary({n for n in AGENTS if asleep(n)}))
    if after is not None:
        for m in load():
            if m["id"] > after:
                show(m)
                state["last"] = m["id"]
        after = None
    threading.Thread(target=follow, daemon=True).start()
    threading.Thread(target=animate, daemon=True).start()
    def reading():  # readline has drawn its prompt and waits for keys: from now on redraws must redraw the prompt
        with lock:
            state["reading"] = True
    readline.set_pre_input_hook(reading)
    while True:
        try:
            pr = prompt()
            line = input(pr)
        except (EOFError, KeyboardInterrupt):
            with lock:
                state["reading"] = False
                if state["shown"] and tty:
                    sys.stdout.write("\r\033[K\033[1A\r\033[K")
                state["stop"] = True
            print()
            break
        with lock:
            state["reading"] = False   # until the next input() draws its own prompt
        cols = shutil.get_terminal_size().columns
        vis = len(f"[to {state['to']}] > ") + len(line)
        echo_rows = max(1, -(-vis // cols))   # screen rows your typed line occupies (it gets replaced once posted)
        with lock:  # Enter pushed the typing line up: put your line in its place so it stays above the prompt
            if state["shown"] and tty:
                if vis < cols:
                    sys.stdout.write("\033[2A\r\033[K" + pr + line + "\r\n\033[K")
                    sys.stdout.flush()
                else:
                    echo_rows += 1   # the stale typing line sits above it: clear that too
                state["shown"] = False
        line = line.strip()
        if not line:
            continue
        if line in ("/q", "/quit", "/exit"):
            with lock:
                state["stop"] = True
            break
        if line == "/all":
            for m in load():
                show(m)
            continue
        if line == "/status":
            emit(subprocess.run([sys.executable, os.path.realpath(__file__), "status"], capture_output=True, text=True).stdout.rstrip())
            continue
        if line.startswith(("/sleep", "/wake")):
            cmd, *rest = line[1:].split()
            for n in (rest[:1] or [""])[0].split(","):
                if n not in AGENTS:
                    emit(col("31", f"usage: /{cmd} NAME[,NAME] [30m] [until NAME]; agents: {', '.join(AGENTS)}"))
                    break
                wf = rest[rest.index("until") + 1].split(",") if "until" in rest[:-1] else []
                dur = [x for x in rest[1:] if x != "until" and x not in wf]
                try:
                    sleep_set(n, cmd == "sleep", parse_dur(dur[0]) if cmd == "sleep" and dur else None, "user", wf)
                except ValueError:
                    emit(col("31", f"bad duration {rest[1]!r}; e.g. 30m, 2h"))
            continue
        if line.startswith("/to"):
            state["to"] = line[3:].strip() or "all"
            continue
        if line.startswith("@"):
            tgt, _, line = line[1:].partition(" ")
            state["to"] = tgt
            line = line.strip()
            if not line:
                continue
        try:
            m = post("user", state["to"], line)
        except SystemExit as e:
            emit(col("31", str(e)))
            continue
        seen("user", max(seen("user"), m["id"]))
        with lock:
            fresh = state["last"] == m["id"] - 1   # nothing arrived in between, so your line is right above
            state["last"] = max(state["last"], m["id"])
        if tty and fresh:   # swap your typed line for the numbered message
            with lock:
                sys.stdout.write(f"\033[{echo_rows}A\r\033[J")
            show(m)
        else:
            state["mine"].add(m["id"])
            emit(col("2", f"posted #{m['id']}"))
    state["stop"] = True


def parse_dur(d):
    if not d:
        return None
    mult = {"s": 1, "m": 60, "h": 3600}.get(d[-1].lower())
    return float(d[:-1]) * mult if mult else float(d) * 60


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd")
    p = sp.add_parser("post"); p.add_argument("-a", "--as", dest="who", required=True)
    p.add_argument("-t", "--to", default="all"); p.add_argument("-f", "--file"); p.add_argument("text", nargs="*")
    p.add_argument("-q", "--no-follow", action="store_true", help="just post; don't open the live chat")
    p = sp.add_parser("chat"); p.add_argument("-t", "--to", default="all")
    p.add_argument("--last", type=int, default=6, help="show this many earlier messages on joining")
    p = sp.add_parser("read"); p.add_argument("-a", "--as", dest="who"); p.add_argument("--new", action="store_true")
    p.add_argument("--last", type=int); p.add_argument("--json", action="store_true")
    p = sp.add_parser("wait"); p.add_argument("-a", "--as", dest="who", required=True)
    p.add_argument("--timeout", type=float, default=0)
    p.add_argument("--until", help="block until this participant (e.g. codex) posts, or you are pinged")
    p = sp.add_parser("idle"); p.add_argument("-a", "--as", dest="who", required=True)
    p = sp.add_parser("doing"); p.add_argument("-a", "--as", dest="who", required=True)
    p.add_argument("--id", help="a concurrent action (several may run at once); without --id TEXT sets the phase")
    p.add_argument("--bg", action="store_true", help="the action runs in the background")
    p.add_argument("--done", action="store_true", help="the action with --id finished")
    p.add_argument("text", nargs="*")
    p = sp.add_parser("sleep", help="stop answering messages to all until pinged (@name or -t name)")
    p.add_argument("-a", "--as", dest="who", required=True); p.add_argument("--for", dest="dur", help="e.g. 30m, 2h")
    p.add_argument("--until", help="also wake when this participant (e.g. codex) posts next")
    p.add_argument("why", nargs="*")
    p = sp.add_parser("wake"); p.add_argument("-a", "--as", dest="who", required=True)
    p = sp.add_parser("hook", help="Claude Code tool hook (reads hook JSON on stdin)"); p.add_argument("phase", choices=["pre", "post"])
    sp.add_parser("protocol"); p = sp.add_parser("intro"); p.add_argument("name", choices=["hydrogen"])
    sp.add_parser("sync"); sp.add_parser("status")
    for n in AGENTS:
        sp.add_parser(n, help=f"run {n} once headlessly on the thread")
    p = sp.add_parser("reset", help="drop agent sessions; their next turn starts fresh"); p.add_argument("name", nargs="?", default="all")
    p = sp.add_parser("serve"); p.add_argument("--budget", type=int, default=BUDGET)
    p.add_argument("--only", help="comma list of agents to serve (default: config serve, else all)")
    a = ap.parse_args()

    if a.cmd in (None, "chat"):
        msgs = load()
        last = getattr(a, "last", 6)
        return chat(getattr(a, "to", "all"), after=msgs[-min(last, len(msgs))]["id"] - 1 if msgs and last else None)
    if a.cmd == "post":
        live = a.who.lower() == "user" and not a.no_follow and sys.stdin.isatty() and sys.stdout.isatty()
        if live and not a.text and not a.file:
            return chat(a.to)
        text = (open(a.file).read() if a.file else sys.stdin.read() if a.text == ["-"] or not a.text
                else " ".join(a.text))
        m = post(a.who, a.to, text)
        if a.who.lower() in NAMES:
            seen(a.who.lower(), max(seen(a.who.lower()), m["id"]))
        print(f"posted #{m['id']}")
        if live:
            chat(a.to, after=m["id"] - 1)
    elif a.cmd == "read":
        msgs = load()
        if a.new:
            if not a.who:
                sys.exit("--new needs -a NAME")
            msgs = [m for m in msgs if for_me(m, a.who) and m["id"] > seen(a.who)]
            if msgs:
                seen(a.who, msgs[-1]["id"])
        if a.last:
            msgs = msgs[-a.last:]
        print("\n".join(json.dumps(m, ensure_ascii=False) for m in msgs) if a.json else "\n".join(fmt(m) for m in msgs))
    elif a.cmd == "wait":
        t0 = time.time()
        if a.until:
            sleep_set(a.who, True, why="waiting for " + a.until, until_from=a.until.lower().split(","))
        while True:
            msgs, last = load(), seen(a.who)
            if any(for_me(m, a.who) and m["id"] > last for m in msgs):
                new = [m for m in msgs if m["id"] > last and m["from"] != a.who]  # everything, not just yours
                seen(a.who, msgs[-1]["id"])
                sleep_set(a.who, False)
                if a.who != "user":
                    busy(a.who, True, "reading the new messages")
                print("\n".join(fmt(m) for m in new))
                return
            if a.timeout and time.time() - t0 > a.timeout:
                sys.exit(3)
            time.sleep(2)
    elif a.cmd == "idle":
        busy(a.who.lower(), False)
    elif a.cmd == "doing":
        if a.id:
            act(a.who.lower(), a.id, None if a.done else (" ".join(a.text) or "working"), bg=a.bg)
        else:
            busy(a.who.lower(), True, " ".join(a.text) or "thinking")
    elif a.cmd == "sleep":
        wf = a.until.lower().split(",") if a.until else []
        sleep_set(a.who.lower(), True, parse_dur(a.dur), " ".join(a.why), wf)
        print(f"{a.who} sleeps until pinged" + (f" or {a.until} posts" if wf else "") + (f" or {a.dur} pass" if a.dur else ""))
    elif a.cmd == "wake":
        sleep_set(a.who.lower(), False)
    elif a.cmd == "hook":
        claude_hook(a.phase)
    elif a.cmd == "protocol":
        print(protocol())
    elif a.cmd == "intro":
        code, pre = winpath(CODE)
        print(template(a.name.upper() + ".md", code=code, cmd=pre + os.path.realpath(__file__)))
    elif a.cmd == "sync":
        print(f"synced {sync()} files to {CODE}")
    elif a.cmd in AGENTS:
        m = run_agent(a.cmd)
        print("slept" if m == "slept" else f"posted #{m['id']}" if m else "no reply")
    elif a.cmd == "serve":
        import threading
        who = [x for x in (a.only.split(",") if a.only else AUTO)]
        print(f"serving {who} in parallel (budget {a.budget} agent msgs per user msg); Ctrl-C to stop", flush=True)
        working, lock = set(), threading.Lock()

        def turn(name):
            try:
                m = run_agent(name, do_sync=False)
                print(f"{time.strftime('%H:%M:%S')} {name} -> " + ("asleep" if m == "slept" else
                      f"#{m['id']}" if m else "failed"), flush=True)
            except subprocess.TimeoutExpired:
                print(f"{name} -> timed out", flush=True)
            except Exception as e:  # keep serving the others
                print(f"{name} -> error {e!r}", flush=True)
            finally:
                busy(name, False)
                with lock:
                    working.discard(name)

        while True:
            msgs = load()
            todo = []
            for name in who:
                if name in working:
                    continue
                pend = [m for m in msgs if m["id"] > seen(name) and for_me(m, name)]
                if not pend:
                    continue
                if agent_streak(msgs) >= a.budget:
                    print(f"{name}: budget reached ({a.budget} agent msgs since the user spoke); waiting", flush=True)
                    seen(name, msgs[-1]["id"])
                    continue
                todo.append((name, pend))
            if todo:
                with lock:
                    idle = not working
                if idle:  # refresh the code snapshot only when no agent is reading it
                    sync()
                for name, pend in todo:
                    print(f"{time.strftime('%H:%M:%S')} {name} replying to {[m['id'] for m in pend]}", flush=True)
                    busy(name, True)
                    with lock:
                        working.add(name)
                    threading.Thread(target=turn, args=(name,), daemon=True).start()
            time.sleep(2)
    elif a.cmd == "reset":
        for n in (AGENTS if a.name == "all" else [a.name]):
            if session(n):
                session(n, drop=True)
                print(f"{n}: session dropped; next turn starts fresh")
    elif a.cmd == "status":
        msgs = load()
        print(f"{len(msgs)} messages; agent streak {agent_streak(msgs)}; code snapshot: "
              + (open(os.path.join(CODE, 'SNAPSHOT.txt')).read().strip() if os.path.exists(CODE) else "none"))
        for n in NAMES:
            z = asleep(n)
            print(f"  {n:8s} seen #{seen(n)}, unread {sum(1 for m in msgs if for_me(m, n) and m['id'] > seen(n))}"
                  + (", asleep until pinged" + (f" or {','.join(z['from'])} posts" if z.get("from") else "") + (time.strftime(" (or %H:%M)", time.localtime(z["until"])) if z["until"] else "")
                     if z else ""))
        for n in AGENTS:
            se = session(n)
            print(f"  {n:8s} " + (f"session {se['id'][:8]}…: {se.get('turns', 0)}/{MAX_TURNS} turns, "
                                  f"{se.get('tokens', 0) // 1000}k/{MAX_TOKENS // 1000}k tokens, since {se.get('started')}"
                                  if se else "no session (next turn starts fresh)") + (" [served]" if n in AUTO else ""))


if __name__ == "__main__":
    main()
