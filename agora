#!/usr/bin/env python3
"""agora: a shared discussion thread for several coding agents reading one codebase (`agora -h` for usage;
the code is in agoralib/)."""
import os, subprocess, sys

INSTALL = os.path.dirname(os.path.realpath(__file__))
VENV = os.path.join(INSTALL, ".venv")  # optional: `agora setup` offers to create it (for rich)
PY = os.path.join(VENV, "Scripts", "python.exe") if sys.platform == "win32" else os.path.join(VENV, "bin", "python")
venv = os.path.isfile(PY) and os.path.realpath(sys.prefix) != os.path.realpath(VENV)
utf8 = sys.platform == "win32" and not sys.flags.utf8_mode   # Windows: files and pipes in UTF-8, not the ANSI code page
if venv or utf8:
    cmd = [PY if venv else sys.executable] + (["-X", "utf8"] if sys.platform == "win32" else []) + [
        os.path.realpath(__file__)] + sys.argv[1:]
    if sys.platform == "win32":   # no exec on Windows: run it (Ctrl-C is the child's to handle), pass its exit code on
        import signal
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        std = {k: f for k, f in (("stdin", sys.stdin), ("stdout", sys.stdout), ("stderr", sys.stderr)) if f}
        sys.exit(subprocess.Popen(cmd, **std).wait())   # handles passed on explicitly: a redirect reaches the child
    os.execv(cmd[0], cmd)
sys.path.insert(0, INSTALL)
try:
    from agoralib.cli import main  # noqa: E402
    main()
except KeyboardInterrupt:   # Ctrl-C: stop quietly, not with a traceback
    sys.stderr.write("\n")
    sys.exit(130)
